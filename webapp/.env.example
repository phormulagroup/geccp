# Este projeto usa os modos do Vite para separar ambientes:
#   .env.development — npm run dev            (local)
#   .env.staging      — npm run build:staging  (staging)
#   .env.production   — npm run build          (produção)
#
# Os três já estão no repositório com os URLs atuais, porque não têm segredos
# (só o URL público da API). Este .env.example serve de referência/modelo.

VITE_API_URL=http://localhost:4000
